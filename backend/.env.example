PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/lexguard?retryWrites=true&w=majority
NODE_ENV=development
AI_MODEL_NAME=lexguard-default

# Optional: Hugging Face Serverless Inference (OpenAI-compatible)
# Get a token from https://huggingface.co/settings/tokens and ensure it has inference permissions.
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct